# Copy to .env (git-ignored). Values are secrets; never commit them.
# Read-only token for a private source repository (https). Leave empty for public repos or ssh deploy keys.
BTEAM_SOURCE_TOKEN=
# Read-only token for the issue API (issues: read).
BTEAM_ISSUES_TOKEN=
# Where the mirror lives (default ./data) and which config to load (default ./instance.yaml).
BTEAM_DATA_DIR=./data
BTEAM_CONFIG=./instance.yaml
