# Copy to .env (git-ignored). Values are secrets; never commit them.
# Read-only token for a private source repository (https). Leave empty for public repos or ssh deploy keys.
BTEAM_SOURCE_TOKEN=
# Read-only token for the issue API (issues: read).
BTEAM_ISSUES_TOKEN=
# Where the mirror lives (default ./data) and which config to load (default ./instance.yaml).
BTEAM_DATA_DIR=./data
BTEAM_CONFIG=./instance.yaml
# Bind address for "serve" (default 127.0.0.1). The container image sets 0.0.0.0; don't set it elsewhere.
# BTEAM_HOST=127.0.0.1
# PORT=8080
# Built static HTML site served at /docs for signed-in users.
# Unset to leave /docs unanswered. Overrides docs.dir in the instance config.
# DOCS_DIR=/var/lib/bteam/docs
# Path prefixes under /docs that answer 404 are docs.hide_paths in the instance config.
# Markdown audience values are the audiences list in the instance config.
# When that list is omitted it is all. A role's audiences list replaces it for that role.
